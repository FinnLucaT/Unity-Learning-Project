    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: '<b>1.</b>  In the <b>Project</b> window, open <b>_Unity Essentials</b>
      > <b>Scenes.</b>


      <b>2.</b>  Double-click <b>1_Playground_Navigation_Scene</b>
      to open it.'
