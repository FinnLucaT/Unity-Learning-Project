--- !u!114 &5713048631147166959
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  Activate Flythrough mode in the <b>Scene</b> view
      by holding the right mouse button and using the <b>WASD</b> keys to navigate.
      \n\n<b>2.</b> Locate the hidden number on the back of the top bar of the swingset.
      \n\n<b>Tip:</b> You might want to write down the hidden numbers as you find
      them so you don't forget!"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
