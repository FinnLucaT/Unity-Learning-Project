  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Remember, the <b>Hierarchy</b> window represents the structure
      of the current scene in a tree-like format. It shows you every GameObject in
      your scene. \n\nWhen you double-click a GameObject in the <b>Hierarchy</b>
      window, you can quickly zoom in on it and frame it nicely in the <b>Scene</b>
      view."
--- !u!114 &5700121090518840670
