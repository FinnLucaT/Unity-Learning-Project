    m_Url: https://storage.googleapis.com/learn-media-public/Essentials-Pathway/1.4%20-%20Create%20a%20mural%20in%20Scene%20view/1.4.3%20-%20Select%20the%20Move%20tool%20with%20global%20coordinates%20-%20VIDEO_V2.webm
    m_AutoStart: 0
