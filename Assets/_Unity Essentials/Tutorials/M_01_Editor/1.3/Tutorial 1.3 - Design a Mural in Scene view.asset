    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Congratulations on successfully completing the <b>Scene</b>
      view flying test! \n\nYou have set yourself up for success moving forward and
      will be able to create what you want much more efficiently now."
