    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b> Go to <a href=\"https://learn.unity.com/pathway/unity-essentials-in-editor/unit/editor-essentials/tutorial/complete-mission-1-in-the-editor?version=6.3#69c549ff1c21596c234cf50a\">Complete
