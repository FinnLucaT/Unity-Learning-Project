--- !u!114 &633744306322848554
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "You may have noticed an inactive GameObject in the <b>Hierarchy</b>
      window named <b>Tube_Slide.</b> Unfortunately, this tube slide is broken into
      three pieces and needs to be assembled \u2014 that\u2019s your job! \n\nThis
      optional challenge is classified as Expert difficulty."
--- !u!114 &785927914800417742
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "In addition to the main <b>WASD</b> keys for moving in Flythrough
      mode, you can also use the Q and E keys to fly straight up and down. Using
      Q and E can really help in certain 3D navigation predicaments. \n\nOnce you\u2019re
      comfortable using the <b>WASD</b> keys, try to incorporate <b>Q</b> and <b>E</b>
      into your Flythrough mode navigation. \n\nThis optional challenge is classified
      as Easy difficulty."
