  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "The best way to get comfortable with Unity is practice, practice,
      practice. Why not add another mural to your scene to get some more practice
      with the <b>Move</b> and <b>Rotate</b> tools, and spruce up the playground
      scene a bit while you\u2019re at it? \n\nThis optional challenge is classified
      as Medium difficulty."
