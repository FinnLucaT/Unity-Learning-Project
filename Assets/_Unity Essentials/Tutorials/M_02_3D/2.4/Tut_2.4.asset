  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "In this tutorial, you will edit the sun, sky, and camera angle
      to get the perfect shot of the scene. \n\nWhen you\u2019re ready to get started,
      go on to the next step."
