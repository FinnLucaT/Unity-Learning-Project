--- !u!114 &2899687939777002108
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  Navigate to <b>_Unity Essentials</b> > <b>Prefabs</b>
      > <b>Bedroom</b> and select each of the beds to preview them at the bottom
      of the <b>Inspector</b> window.\n\n<b>2.</b>  Drag a bed prefab into your scene,
      then use the <b>Move</b> and <b>Rotate</b> tools to position it with its back
      against the left wall. \n\n<b>Important:</b> Don't double-click the bed prefabs
      in the <b>Project</b> window \u2014 just single-click them to preview them.\n\n<b>Tip:</b>
      You can always undo any unwanted edits with <b>Ctrl+Z</b>  (macOS: <b>Cmd+Z</b>)."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
