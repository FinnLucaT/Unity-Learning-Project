  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Congratulations on completing the first steps on this room!
      You've successfully opened a 3D scene, added and positioned a bedroom prefab,
      and personalized the space with furniture. \n\nHere are some of the things
      you learned how to do along the way:\n\n\u2022 Add an instance of a prefab
      to a scene by dragging the prefab from the <b>Project</b> window. (<a href='https://docs.unity3d.com/Manual/Prefabs.html?utm_source=learnTPOCi'>more</a>)\n\u2022
      Use the Transform component to position a GameObject. (<a href='https://docs.unity3d.com/Manual/class-Transform.html?utm_source=learnTPOCi'>more</a>)\n"
