    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "In the <b>Project</b> window, navigate to <b>_Unity Essentials</b>
      > <b>Scenes</b> and double-click <b>2_KidsRoom_3D_Scene</b> to open it. \n\nYou'll
      see a big empty white ground object in front of a blue sky in the <b>Scene</b>
      view. \n\nDon\u2019t worry if your view of the scene doesn\u2019t match the
      view in the example!"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
--- !u!114 &2264729775255647424
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
