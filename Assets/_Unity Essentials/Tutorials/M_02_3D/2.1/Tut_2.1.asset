  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  In the <b>Hierarchy</b> window, select the <b>01_Bedroom</b>
      GameObject. \n\n<b>2.</b>  Go to the <b>Inspector</b> window and set the <b>Position</b>
      values in the <b>Transform</b> component to <b>X = 0, Y = 0,</b> and <b>Z =
      0.</b>\n\n<b>Note:</b>  Remember to save your scene regularly with <b>Ctrl+S</b>
      (macOS: <b>Cmd+S</b>)."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
