--- !u!114 &9135576078108412152
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  Add a new <b>Block</b> prefab to a spot on the floor,
      then drag another two blocks onto the floor next to it. \n\n<b>2.</b>  Hold
      down the <b>V</b> key on your keyboard while you select one of the bottom vertices
      of a block you want to put on top of another. \n\n<b>3</b>.  Drag your cursor
      toward the target vertex on another block, and the vertices will snap together.\n\n<b>Note:</b>
      While holding <b>V</b> and hovering a block\u2019s corner, a direction gizmo
      (similar to the Move tool) will appear. Do not drag using the gizmo\u2019s
      arrows, drag the Block from the vertex itself.\n\n<b>4.</b> Repeat this process
      to create a perfectly aligned tower that is three or four blocks high."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
