--- !u!114 &796664382871401555
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  With the <b>Block </b>GameObject selected, select
      <b>Add Component</b> at the bottom of the <b>Inspector</b> window, then search
      for and add a <b>Rigidbody</b> component.\n\n<b>2.</b>  Enter <b>Play</b> mode
      to test the interaction. \n\nObserve that the block now gets knocked over when
      hit by the ball. \n\n<b>Note:</b>  Remember to save your scene often with <b>Ctrl+S</b>
      (macOS: <b>Cmd+S</b>)."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
