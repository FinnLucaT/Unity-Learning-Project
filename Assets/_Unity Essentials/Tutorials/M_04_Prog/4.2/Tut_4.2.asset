    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "In this step, you\u2019ll create a new empty script. This script,
      which you\u2019ll name \"Collectible\", will govern the behavior of the collectible
      objects in the scene. "
