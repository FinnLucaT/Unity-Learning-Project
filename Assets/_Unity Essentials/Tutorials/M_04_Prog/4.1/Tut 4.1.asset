--- !u!114 &-6781869034852030986
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  Locate the <b>PlayerController</b> script in the
      Unity Editor's <b>Project</b> window. \n\n<b>2.</b>  Double-click the script
      file to open it in your default script editor, such as Visual Studio. \n\nIt
      may take a while to open the application the first time.\n\nWhen the IDE opens,
      you'll see the default starter code that generates any time you create a new
      script. \n\n<b>Note</b>: Don\u2019t worry if your IDE doesn\u2019t look identical
      to the one shown in the demo videos. \n\nIf the script doesn\u2019t open in
      an IDE, follow <a href=\"https://learn.unity.com/tutorial/explore-the-unity-hub?version=6.0#694187f90ee6cf905aae55fc\">these
      instructions</a> to install Visual Studio, relaunch Unity, and try opening
      the script again."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
