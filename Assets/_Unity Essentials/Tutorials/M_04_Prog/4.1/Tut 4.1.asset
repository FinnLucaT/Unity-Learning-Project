  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "It is time to create your first C# script! \n\n<b>C#</b> (pronounced
      \u201Csee-sharp\u201D) is a versatile programming language that is widely used
      for developing a broad range of applications, from web to mobile to game development,
      and particularly with Unity for game scripting.\n\nYour first <b>script,</b>
      which is just a document with code in it, will be named \"PlayerController\".
      In this script, you'll define how your player interacts within the game world."
