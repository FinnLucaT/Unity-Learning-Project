  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.</b>  Go to the <a href=\"https://learn.unity.com/pathway/unity-essentials-in-editor/unit/publishing-essentials/tutorial/complete-mission-6-in-the-editor?version=6.3#66c3b015edbc2a18fb172e9c\">Complete
      Mission 6 in the Editor</a> on Unity Learn and select <b>Mark All Steps Complete</b>.\n\n<b>2.</b>
      Follow the instructions in the <a href=\"https://learn.unity.com/pathway/unity-essentials-in-editor/unit/publishing-essentials/tutorial/share-your-project?version=6.3#664e4d76edbc2a0827478d91\">Share
      your project</a> tutorial on Unity Learn to upload your project.\n\n<b>3.</b> 
      Take a look at some of the other submissions and consider commenting on another
      learner\u2019s work.\n\nOnce you\u2019ve finished these steps, you will have
      successfully completed the Unity Essentials Pathway\u2014congratulations! That\u2019s
      an amazing accomplishment.\n\n<b>Note:</b> To earn your badge, remember to
      mark all tutorials in the <a href=\"https://learn.unity.com/pathway/unity-essentials-in-editor?version=6.3\">Unity
      Essentials: In-Editor Pathway</a>  as complete and submit your project. \n\nThe
      only question remaining is: what will you create next?"
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
