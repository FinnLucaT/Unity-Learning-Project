  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Recording a video of your application is an excellent way to
      showcase your project. You can share a video anywhere: you can post it on social
      media, you can embed it on your website, or you can send it to your mom in
      a text message!  \n\nIn this tutorial, you\u2019ll use Unity\u2019s <b>Recorder
      package</b> to capture and export videos directly from the Editor. \n\nYou\u2019ll
      then have a chance to upload this video to Unity Learn to get credit for completing
      the entire Unity Essentials Pathway."
