  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: Instructions
  Text:
    m_Untranslated: "<b>1.  Select the Web platform:</b>\n\n\_\_\_\_<b>\u2022</b>
      If the <b>Build Profiles</b> window is not already open, re-open it (<b>File</b>
      > <b>Build Profiles</b>).\n\n\_\_\_\_<b>\u2022</b> In the <b>Platforms</b>
      section, select <b>Web</b>.\n\n<b>2.  Switch platforms:</b>\n\n\_\_\_\_<b>\u2022</b>
      Select the <b>Switch Platform</b> button and wait for the process to complete.\n\n\_\_\_\_<b>\u2022</b>
      This process will take a few minutes.\n\n<b>Tip:</b> If the <b>Web</b> platform
      appears grayed out, select <b>Install with Unity Hub</b> and install the <b>WebGL
      Build Support</b> module before switching platforms.\n(You have to restart
      the Editor once install is completed)\n\nAfter this process is complete, your
      project assets and settings are configured for deployment to the Web platform."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
