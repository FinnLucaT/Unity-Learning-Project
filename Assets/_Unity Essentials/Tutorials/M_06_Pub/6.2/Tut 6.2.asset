  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "Publishing a Unity project lets you share your game on different
      platforms, like mobile and web.\n\nIn this tutorial, you'll build your project
      for the Web platform so that anyone with the link can instantly and easily
      play your game. You\u2019ll then publish your game to <b>Unity Play</b>, Unity\u2019s
      free web hosting platform."
